PORT=3000
DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PINCC_API_KEY=
PINCC_BASE_URL=https://v2.pincc.ai
PINCC_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
DIAGNOSIS_TIMEOUT_MS=15000
# Bearer token for the control plane. Without it every state-changing route is disabled.
CONTROL_PLANE_TOKEN=
# HMAC secret the deterministic simulator verifies webhooks against. Absent means a fresh secret
# per process, so no outside caller can sign a delivery this instance would accept.
SIMULATOR_WEBHOOK_SECRET=
# The Razorpay recurring mandate charge has never been proven against the account, so it is off.
# Set to true only after tests/razorpay-recurring-proof.test.ts has run green with real Test Mode
# credentials. The fallback payment link stays enabled either way.
RAZORPAY_RECURRING_RETRY_ENABLED=false
