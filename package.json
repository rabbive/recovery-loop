{
  "name": "recovery-loop",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted recovery for failed SaaS renewal payments",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json && cp src/persistence.sql dist/src/persistence.sql",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:postgres": "vitest run tests/persistence.test.ts tests/postgres-concurrency.test.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
